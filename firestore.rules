rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jesuraj1994@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email)))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection document
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Admin Emails Collection
    match /admin_emails/{emailId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Members Directory Collection
    match /members/{memberId} {
      allow read: if true;
      allow create: if isSignedIn() && (isValidId(memberId) || isSuperAdmin());
      allow update: if isSignedIn() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Matrimonial Profiles Collection
    match /matrimonial/{profileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isSuperAdmin() || resource.data.createdBy == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Donations & Ledger Collection
    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Business Advertisements Collection
    match /business_ads/{adId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isSuperAdmin() || resource.data.memberId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }
  }
}
